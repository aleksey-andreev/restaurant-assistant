# Copy this file to .env on the target VM and fill with real values.

# App
APP_HOST=0.0.0.0
APP_PORT=8000

# External PostgreSQL (already created on another server)
DATABASE_URL=postgresql+psycopg://db_user:db_password@db-hostname-or-ip:5432/db_name

# LLM provider: CLOUDRU | YANDEX
LLM_PROVIDER=CLOUDRU

# LLM (Cloud.ru Foundation Models)
CLOUDRU_FOUNDATION_MODELS_API_KEY=
CLOUDRU_FOUNDATION_MODELS_URL=https://foundation-models.api.cloud.ru/v1

# LLM (Yandex Cloud, OpenAI-compatible)
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_CLOUD_API_KEY_ID=

# Yandex Cloud Search
YANDEX_SEARCH_URL=https://searchapi.api.cloud.yandex.net/v2/web/search
YANDEX_SEARCH_API_KEY_ID=
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Toka Backoffice API
TOKA_REST_URL=https://backoffice.toka.rest
TOKA_USERNAME=
TOKA_PASSWORD=
# Test org/store for dialog pipeline capacity check (real ids from your Toka test account; see .cursor/rules/restaurant-assistant.mdc)
TOKA_STUB_ORGANIZATION_ID=
TOKA_STUB_STORE_ID=
